{
  "rewrites": [
    { "source": "/v1/catalog", "destination": "/v1/catalog.json" },
    { "source": "/((?!assets/|images/|v1/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/v1/catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
