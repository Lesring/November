<view class="page">
  <view class="h1">发现</view>
  <view class="search">
    <input
      placeholder="搜索器物、材质或创作者"
      confirm-type="search"
      value="{{q}}"
      bindinput="onInput"
    />
    <view class="orb">搜</view>
  </view>
  <scroll-view class="chips" scroll-x>
    <view class="chip {{categoryId === 'all' ? 'on' : ''}}" data-id="all" bindtap="onChip">全部</view>
    <view
      class="chip {{categoryId === item.id ? 'on' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onChip"
    >{{item.name}}</view>
  </scroll-view>
  <scroll-view class="chips" scroll-x>
    <view
      class="chip {{item.on ? 'on' : ''}}"
      wx:for="{{certifications}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCert"
    >{{item.label}}</view>
  </scroll-view>
  <view class="chips">
    <view
      class="sort {{sort === item.id ? 'on' : ''}}"
      wx:for="{{sorts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSort"
    >{{item.label}}</view>
  </view>
  <view class="muted" style="margin-top: 20rpx;">共 {{products.length}} 件</view>
  <view class="empty" wx:if="{{products.length === 0}}">
    <view class="h2">没有找到相符的器物</view>
    <view class="muted">换个词，或清掉筛选。</view>
    <view class="btn secondary" style="margin-top: 24rpx;" bindtap="onClear">清空筛选</view>
  </view>
  <view class="grid" wx:else style="margin-top: 24rpx;">
    <view class="cell" wx:for="{{products}}" wx:key="id">
      <product-card product="{{item}}" bind:open="onOpen" bind:heart="onHeart" />
    </view>
  </view>
</view>
