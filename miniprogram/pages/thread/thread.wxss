.thread-page { padding-bottom: 180rpx; }
.who {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.who image, .avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f2f2f2;
}
.avatar-fallback {
  color: #f06543;
  text-align: center;
  line-height: 80rpx;
  font-weight: 700;
}
.name { font-weight: 600; }
.bubble-row {
  display: flex;
  margin-top: 16rpx;
}
.bubble-row.me { justify-content: flex-end; }
.bubble-row.them { justify-content: flex-start; }
.bubble {
  max-width: 78%;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #ebebeb;
}
.bubble.me {
  background: #ffe8e1;
  border-color: transparent;
  border-bottom-right-radius: 8rpx;
}
.bubble-row.them .bubble { border-bottom-left-radius: 8rpx; }
.bubble.media { padding: 8rpx; }
.bubble-image {
  width: 420rpx;
  border-radius: 16rpx;
}
.bubble-file .file-name { font-weight: 600; }
.msg-time {
  margin-top: 8rpx;
  color: #6a6a6a;
  font-size: 20rpx;
  text-align: right;
}
.bubble.typing { color: #6a6a6a; }
.reply-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebebeb;
}
.tool {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
  color: #3f3f3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.reply-bar input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 16rpx;
}
.send {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f06543;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send image { width: 40rpx; height: 40rpx; }
