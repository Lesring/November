<view class="page">
  <view class="kicker">会员</view>
  <view class="h1">{{membership.headline}}</view>
  <view class="lede">{{membership.intro}}</view>
  <view class="tier {{item.recommended ? 'rec' : ''}}" wx:for="{{membership.tiers}}" wx:key="id">
    <view class="link" wx:if="{{item.recommended}}" style="position: absolute; right: 32rpx; top: 32rpx;">推荐</view>
    <view class="h2">{{item.name}}</view>
    <view style="font-size: 40rpx; font-weight: 600; margin: 8rpx 0;">{{item.priceLabel}}</view>
    <view class="muted">{{item.blurb}}</view>
    <view class="perk" wx:for="{{item.perks}}" wx:for-item="perk" wx:key="*this">{{perk}}</view>
  </view>
  <view class="btn primary" style="margin-top: 32rpx;" bindtap="onJoin">了解会员</view>
  <view class="small" style="margin-top: 16rpx; text-align: center;">{{membership.note}}</view>
</view>
