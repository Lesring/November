page {
  background: #fff;
  color: #222;
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
.page {
  padding: 32rpx 40rpx 180rpx;
}
.page.sub {
  padding-bottom: 180rpx;
}
.wordmark {
  color: #ff385c;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.tag {
  color: #6a6a6a;
  font-size: 26rpx;
}
.kicker {
  color: #6a6a6a;
  font-size: 24rpx;
  font-weight: 600;
}
.h1 {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 8rpx;
}
.h2 {
  font-size: 40rpx;
  font-weight: 500;
}
.lede, .body {
  color: #3f3f3f;
  margin-top: 12rpx;
}
.muted { color: #6a6a6a; }
.small { font-size: 24rpx; color: #6a6a6a; }
.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 48rpx 0 20rpx;
}
.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-top: 28rpx;
  padding: 0 8rpx 0 32rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: rgba(0, 0, 0, 0.02) 0 0 0 1rpx, rgba(0, 0, 0, 0.04) 0 4rpx 12rpx, rgba(0, 0, 0, 0.1) 0 8rpx 16rpx;
}
.search input { flex: 1; font-size: 28rpx; }
.orb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #ff385c;
  color: #fff;
  text-align: center;
  line-height: 76rpx;
  font-size: 32rpx;
}
.chips {
  display: flex;
  white-space: nowrap;
  margin-top: 28rpx;
}
.chip, .sort {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.chip.on {
  background: #222;
  color: #fff;
  border-color: #222;
}
.sort { border: 0; color: #6a6a6a; padding: 8rpx 0; margin-right: 28rpx; }
.sort.on { color: #222; font-weight: 600; }
.scroller { white-space: nowrap; }
.editorial {
  display: inline-block;
  width: 520rpx;
  margin-right: 24rpx;
  vertical-align: top;
  white-space: normal;
}
.editorial image, .cover, .shot {
  width: 100%;
  background: #f2f2f2;
}
.editorial image {
  height: 640rpx;
  border-radius: 40rpx;
}
.editorial .h3 { font-size: 32rpx; font-weight: 600; margin-top: 8rpx; }
.creator {
  display: inline-block;
  width: 220rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}
.creator image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f2f2f2;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cell { width: 48%; }
.rights {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #f7f7f7;
}
.rights .title { font-weight: 600; margin-bottom: 8rpx; }
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.btn.primary { background: #ff385c; color: #fff; }
.btn.secondary {
  background: #fff;
  color: #222;
  box-shadow: inset 0 0 0 2rpx #222;
}
.buybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebebeb;
}
.buybar .btn { flex: 1; margin-right: 16rpx; }
.buybar .btn:last-child { margin-right: 0; }
.foot {
  margin-top: 48rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ebebeb;
  color: #6a6a6a;
  font-size: 24rpx;
}
.panel { margin-top: 28rpx; }
.line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #ebebeb;
}
.line image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #f2f2f2;
}
.line .grow { flex: 1; }
.banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #f7f7f7;
}
.link { color: #ff385c; font-weight: 600; }
.tier {
  position: relative;
  margin-top: 20rpx;
  padding: 32rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 40rpx;
}
.tier.rec { border: 4rpx solid #222; }
.perk { padding: 12rpx 0; border-top: 1rpx solid #ebebeb; font-size: 26rpx; }
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet textarea {
  width: 100%;
  height: 200rpx;
  margin: 20rpx 0;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar-fallback {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f2f2f2;
  color: #ff385c;
  text-align: center;
  line-height: 128rpx;
  font-size: 40rpx;
  font-weight: 700;
}
.gallery {
  height: 670rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f2f2f2;
}
.gallery image { width: 100%; height: 670rpx; }
.cover-img {
  width: 100%;
  height: 420rpx;
  border-radius: 40rpx;
  background: #f2f2f2;
}
.head {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: -40rpx;
}
.head image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid #fff;
  background: #f2f2f2;
}
.story { margin-top: 16rpx; color: #3f3f3f; }
.shot {
  width: 100%;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 28rpx;
}
.spec {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #ebebeb;
  font-size: 26rpx;
}
.cert-row {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #ebebeb;
}
.cert-row .name { width: 140rpx; font-weight: 600; font-size: 26rpx; flex: none; }
.creator-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 28rpx;
}
.creator-card image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f2f2f2;
}
