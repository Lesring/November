.pcard { margin-bottom: 28rpx; }
.photo {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f2f2f2;
}
.photo image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  max-width: 70%;
  background: #fff;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: rgba(0, 0, 0, 0.08) 0 4rpx 12rpx;
}
.heart {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #222;
  text-align: center;
  line-height: 64rpx;
  font-size: 32rpx;
}
.heart.on { color: #ff385c; }
.meta { padding-top: 16rpx; }
.title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}
.muted, .cert { color: #6a6a6a; font-size: 24rpx; margin-top: 4rpx; }
.price { font-size: 28rpx; font-weight: 600; margin-top: 6rpx; }
