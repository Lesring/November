# 复制本文件为项目根目录的 .env 再填写。
# .env 已被 git 忽略。不要提交，也不要把密码发在对话里。
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# 对象存储。在 Sealos「对象存储 → 访问密钥」里复制。用外网地址，不要用内网地址。
# 外网地址如果没有 https://，自己补上。Region 页面没写就填 us-east-1。
S3_ENDPOINT=https://外网地址
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=ad80a2zr-11pr
S3_BUCKET_PRIVATE=ad80a2zr-11p
